{% block trix_widget %}
    {# Ce bloc s'appelle trix_widget car on a défini getBlockPrefix = 'trix' #}
    <input
            type="hidden"
            id="{{ id }}"
            name="{{ full_name }}"
            value="{{ value|e('html_attr') }}"
            {{ block('widget_attributes') }}
    >
    <trix-editor input="{{ attr['data-trix-id'] }}" {{ block('widget_attributes') }}></trix-editor>
{% endblock %}
