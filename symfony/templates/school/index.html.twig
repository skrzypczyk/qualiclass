{% extends 'base.html.twig' %}

{% block title %}Mes écoles{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 py-8">

        {% if school.getImg() is not null and school.getImg() is not empty  %}
            <img src="{{ asset('uploads/schools/'~school.getImg()) }}" class="w-32 h-32 mx-auto mb-6" alt="School Image">
        {% else %}
            <img src="{{ asset('images/logo-qualiclass.png') }}" class="w-32 h-32 mx-auto mb-6" alt="Default School Image">
        {% endif %}

        {{ form_start(form, {'attr': {'data-turbo': 'false','enctype': 'multipart/form-data', 'class': 'space-y-6'}}) }}

        <div>
            {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.name, {
                'attr': {
                    'class': 'block w-full px-4 py-2 rounded-md shadow-sm focus:ring focus:ring-indigo-200 border border-gray-300'
                }
            }) }}

            {% if form.name.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.name) }}</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.description, {
                'attr': {
                    'class': 'block w-full px-4 py-2 rounded-md shadow-sm focus:ring focus:ring-indigo-200 border border-gray-300'
                }
            }) }}

            {% if form.description.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.description) }}</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.img, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.img, {
                'attr': {
                    'class': 'block w-full px-4 py-2 rounded-md shadow-sm focus:ring focus:ring-indigo-200 border border-gray-300'
                }
            }) }}

            {% if form.img.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.img) }}</p>
            {% endif %}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
                {{ form_label(form.primaryColor, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.primaryColor, {'attr': {'style':'height:40px;','class': 'w-full px-4 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.primaryColor) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.primaryColor) }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.secondaryColor, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.secondaryColor, {'attr': {'style':'height:40px;','class': 'w-full px-4 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.secondaryColor) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.secondaryColor) }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.typo, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.typo, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.typo) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.typo) }}</p>
                {% endif %}
            </div>

        </div>


        <div>
            {{ form_label(form.keyChatGpt, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.keyChatGpt, {
                'attr': {
                    'class': 'block w-full px-4 py-2 rounded-md shadow-sm focus:ring focus:ring-indigo-200 border border-gray-300'
                }
            }) }}

            {% if form.keyChatGpt.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.keyChatGpt) }}</p>
            {% endif %}
        </div>

        <button type="submit" class="btn-primary">
            Mettre à jour
        </button>


        {{ form_end(form) }}

    </div>

{% endblock %}
