{% extends 'base.html.twig' %}

{% block title %}Mes écoles{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 py-8">

        {% if user.schoolImg is not null and user.schoolImg is not empty  %}
            <img src="{{ asset('uploads/schools/'~user.schoolImg) }}" class="w-32 h-32 mx-auto mb-6" alt="School Image">
        {% else %}
            <img src="{{ asset('images/logo-qualiclass.png') }}" class="w-32 h-32 mx-auto mb-6" alt="Default School Image">
        {% endif %}

        {{ form_start(form, {'attr': {'data-turbo': 'false','enctype': 'multipart/form-data', 'class': 'space-y-6'}}) }}

        <div>
            {{ form_label(form.schoolName, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.schoolName, {
                'attr': {
                    'class': 'block w-full px-4 py-2 rounded-md shadow-sm focus:ring focus:ring-indigo-200 border border-gray-300'
                }
            }) }}

            {% if form.schoolName.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.schoolName) }}</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.schoolDescription, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.schoolDescription, {
                'attr': {
                    'class': 'block w-full px-4 py-2 rounded-md shadow-sm focus:ring focus:ring-indigo-200 border border-gray-300'
                }
            }) }}

            {% if form.schoolDescription.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.schoolDescription) }}</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.schoolImg, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.schoolImg, {
                'attr': {
                    'class': 'block w-full px-4 py-2 rounded-md shadow-sm focus:ring focus:ring-indigo-200 border border-gray-300'
                }
            }) }}

            {% if form.schoolImg.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.schoolImg) }}</p>
            {% endif %}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
                {{ form_label(form.schoolPrimaryColor, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.schoolPrimaryColor, {'attr': {'style':'height:40px;','class': 'w-full px-4 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.schoolPrimaryColor) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.schoolPrimaryColor) }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.schoolSecondaryColor, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.schoolSecondaryColor, {'attr': {'style':'height:40px;','class': 'w-full px-4 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.schoolSecondaryColor) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.schoolSecondaryColor) }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.schoolTypo, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.schoolTypo, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.schoolTypo) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.schoolTypo) }}</p>
                {% endif %}
            </div>
        </div>

        <button type="submit" class="btn-primary">
            Mettre à jour
        </button>


        {{ form_end(form) }}

    </div>

{% endblock %}
