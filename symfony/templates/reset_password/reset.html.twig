{% extends 'base.html.twig' %}

{% block title %}Définir un nouveau mot de passe{% endblock %}

{% block body %}
    <div class="flex justify-center items-center h-full bg-gray-100 py-12">
        <div class="w-full max-w-md bg-white shadow-md rounded-lg p-8">
            <h1 class="text-2xl font-bold mb-6 text-center text-indigo-600">
                Nouveau mot de passe
            </h1>

            {% if errorMessage is defined and errorMessage %}
                <div class="mb-4 text-sm text-red-800 bg-red-100 px-4 py-2 rounded border border-red-300">
                    {{ errorMessage }}
                </div>
            {% endif %}

            {{ form_start(resetForm, {'attr': {'class': 'space-y-6'}}) }}

            {{ form_row(resetForm.plainPassword.first, {
                label_attr: {'class': 'block text-sm font-medium text-gray-700'},
                attr: {'class': 'block w-full px-4 py-2 border rounded-md shadow-sm focus:ring focus:ring-indigo-200'}
            }) }}

            {{ form_row(resetForm.plainPassword.second, {
                label_attr: {'class': 'block text-sm font-medium text-gray-700'},
                attr: {'class': 'block w-full px-4 py-2 border rounded-md shadow-sm focus:ring focus:ring-indigo-200'}
            }) }}

            <div class="mt-6 flex justify-between gap-4">
                <button type="submit"
                        class="w-full bg-indigo-600 text-white font-semibold py-2 px-4 rounded hover:bg-indigo-700 transition">
                    Confirmer
                </button>

                <a href="{{ path('app_login') }}"
                   class="w-full text-center bg-gray-200 text-gray-800 font-semibold py-2 px-4 rounded hover:bg-gray-300 transition">
                    Annuler
                </a>
            </div>

            {{ form_end(resetForm) }}
        </div>
    </div>
{% endblock %}
