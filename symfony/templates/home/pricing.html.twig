{% extends 'base.html.twig' %}

{% block body %}
    <section class="bg-white py-20 px-6">
        <div class="max-w-5xl mx-auto text-center">
            <h1 class="text-4xl font-bold text-[#142742] mb-6">Tarifs QualiClass</h1>
            <p class="text-gray-700 text-lg mb-4 max-w-3xl mx-auto">
                QualiClass propose une tarification simple, transparente et évolutive, pensée pour s’adapter à la structure de chaque établissement.
            </p>
            <p class="text-gray-600 text-base mb-12 max-w-3xl mx-auto">
                Notre solution vous accompagne dans la mise en conformité avec la certification QUALIOPI, tout en facilitant la gestion pédagogique de vos formations.
            </p>

            <div class="grid md:grid-cols-2 gap-8 text-left">
                <!-- Offre initiale -->
                <div class="bg-gray-100 p-8 rounded-lg shadow-md">
                    <h2 class="text-2xl font-semibold text-[#142742] mb-4">Offre initiale – <span class="text-gray-800">99,99 € / mois</span></h2>
                    <p class="text-gray-700 mb-4">
                        L’offre de base est idéale pour les petites structures ou pour un lancement progressif de la solution QualiClass.
                    </p>
                    <ul class="list-disc list-inside text-gray-600 space-y-2">
                        <li>1 établissement (école ou organisme de formation)</li>
                        <li>4 programmes pédagogiques à intégrer</li>
                        <li>1 administrateur avec droits complets</li>d
                        <li>4 comptes utilisateurs (formateurs, responsables pédagogiques, etc.)</li>
                    </ul>
                    <p class="text-sm text-gray-500 mt-4">Chaque programme peut contenir plusieurs matières, syllabus, compétences visées, etc.</p>
                </div>

                <!-- Extensions -->
                <div class="bg-gray-100 p-8 rounded-lg shadow-md">
                    <h2 class="text-2xl font-semibold text-[#142742] mb-4">Options et extensions</h2>

                    <div class="mb-4">
                        <h3 class="text-lg font-medium text-gray-800">Établissement supplémentaire</h3>
                        <p class="text-gray-600">
                            <strong>19,99 € / mois</strong> pour chaque école ajoutée,
                            incluant 4 programmes pédagogiques supplémentaires.
                        </p>
                        <p class="text-sm text-gray-500 mt-1">
                            Parfait pour les groupes ou réseaux multi-établissements.
                        </p>
                    </div>

                    <div>
                        <h3 class="text-lg font-medium text-gray-800">Utilisateur supplémentaire</h3>
                        <p class="text-gray-600">
                            <strong>9,99 € / mois</strong> pour chaque utilisateur additionnel.
                        </p>
                        <p class="text-sm text-gray-500 mt-1">
                            Gérez facilement la montée en charge de vos équipes pédagogiques.
                        </p>
                    </div>

                    <p class="mt-6 text-sm text-gray-500">
                        Vous pouvez à tout moment ajuster votre abonnement selon l'évolution de vos besoins.
                    </p>
                </div>
            </div>

            <div class="mt-12">
                <a href="{{ path('app_register') }}" class="bg-[#142742] text-white px-6 py-3 rounded hover:bg-[#1a355c] transition">
                    Créer un compte
                </a>
            </div>
        </div>
    </section>
{% endblock %}
