{% extends 'base.html.twig' %}

{% block title %}Nos tarifs{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto px-4 py-12">
        <h1 class="text-3xl font-bold title-primary mb-8">Nos forfaits</h1>

        <p class="text-center text-gray-600 mb-12">
            Découvrez nos offres adaptées à toutes les structures éducatives.
            Chaque forfait vous donne accès à un espace complet pour gérer vos programmes pédagogiques Qualiopi, vos titres RNCP, et bien plus encore.
        </p>


        <div class="grid md:grid-cols-3 gap-4 items-stretch">

        {% for product in products %}
            <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 text-center flex flex-col">
                <img src="{{ product.image }}" alt="{{ product.name }}" class="w-32 h-32 mx-auto my-6  object-contain">
                    <h2 class="text-xl font-semibold text-primary mb-2">{{ product.name }}</h2>
                    <p class="text-gray-600 text-sm mb-6 mt-4 text-left">{{ product.description | raw }}</p>

                    <div class="mt-auto">
                        {% if product.price_amount %}
                            <p class="text-2xl font-bold text-gray-800 mb-1">
                                {{ product.price_amount|number_format(2, ',', ' ')}} €<span class="text-sm text-gray-500">/ mois</span>
                            </p>
                        {% else %}
                            <p class="text-sm text-red-600">Prix non disponible</p>
                        {% endif %}
                    </div>

            </div>
            {% endfor %}
        </div>
    </div>
    <div class="max-w-3xl mx-auto text-center px-4 pb-12 mt-8">
        <a href="{{ path('app_register') }}" class="btn-primary">Créer un compte</a>
    </div>
{% endblock %}
