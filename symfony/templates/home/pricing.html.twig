{% extends 'base.html.twig' %}

{% block title %}Nos tarifs{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto px-4 py-12">
        <h1 class="text-3xl font-bold title-primary mb-8">Nos forfaits</h1>

        <div class="grid md:grid-cols-2 gap-2">
            {% for product in products %}
                <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 text-center">
                    <h2 class="text-xl font-semibold text-primary mb-2">{{ product.name }}</h2>
                    <p class="text-gray-600 text-sm mb-6 mt-4 text-left">{{ product.description | raw }}</p>

                    {% if product.price %}
                        <p class="text-2xl font-bold text-gray-800 mb-1">
                            {{ (product.price / 100)|number_format(2, ',', ' ') }} €
                            <span class="text-sm text-gray-500">/ mois</span>
                        </p>
                    {% else %}
                        <p class="text-sm text-red-600">Prix non disponible</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="max-w-5xl mx-auto text-center">
        <div class="mt-5">
            <a href="{{ path('app_register') }}" class="btn-primary">
                Créer un compte
            </a>
        </div>

    </div>
{% endblock %}
