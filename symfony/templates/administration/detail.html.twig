{% extends 'base.html.twig' %}

{% block title %}Détail - {{ school.name }}{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto py-8">

        <h1 class="text-3xl font-bold title-primary mb-8">{{ school.name }} <a href="{{ path('app_admin') }}" class="mx-4 text-xl btn-primary">Liste des écoles</a></h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for user in school.getUsers() %}
                <div class="bg-white p-4 rounded-lg shadow-md">
                    <h2 class="text-2xl font-semibold my-6">{{ user.email }}</h2>
                    <h3 class="text-2xl font-semibold my-4">Programmes : </h3>
                    {% for program in user.getPrograms() %}
                            <li>
                                <a href="{{ path('app_program_show', { id: program.id, format: 'pdf' }) }}"
                                     class="link-primary">{{ program.title }}</a>
                                {% for diploma in program.getDiplomas() %}
                                    <li class="ml-4"><a href="{{ path('app_program_diploma_show', { program: program.id, diploma: diploma.id, format: 'pdf' }) }}"
                                                        class="link-primary">{{ diploma.title }} - {{ diploma.rncp }}</a></li>
                                    {% else %}
                                        <p>Aucun diplôme associé.</p>
                                {% endfor %}
                            </li>
                    {% else %}
                        <p>Aucun titre RNCP associé.</p>
                    {% endfor %}

                <h3 class="text-2xl font-semibold my-4">Modules : </h3>
                {% for module in user.getModules() %}
                        <li><a href="{{ path('app_module_show', { id: module.id }) }}" class="link-primary">{{ module.title }} - {{ module.duration }}h </a></li>
                {% else %}
                    <p>Aucun module créé.</p>
                {% endfor %}
                </div>
            {% else %}
                <p>Aucun utilisateur enregistré pour cette école.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
