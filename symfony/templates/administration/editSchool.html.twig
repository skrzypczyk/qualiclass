{% extends 'base.html.twig' %}

{% block title %}Édition utilisateur{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 py-8">
        <h1 class="text-2xl font-bold text-[#142742] mb-6">Modification de {{ school.name }}</h1>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

        <div>
            <div class="flex items-center">
                {{ form_label(form.isFreeAccount, null, {'label_attr': {'class': 'inline-flex items-center space-x-2'}}) }}
                {{ form_widget(form.isFreeAccount, {'attr': {'class': 'form-checkbox h-5 w-5 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 ml-4'}}) }}
                {{ form_errors(form.isFreeAccount) }}
            </div>
        </div>

        <div>
            {{ form_label(form.limitUsers, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.limitUsers, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
            {% if form_errors(form.limitUsers) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.limitUsers) }}</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
            {% if form_errors(form.name) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.name) }}</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            <div data-controller="quill">
                <div class="quill-editor" style="height: 300px;"></div>
                {{ form_widget(form.description, { attr: { style: 'display:none;' } }) }}
            </div>

            {% if form.description.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.description) }}</p>
            {% endif %}
        </div>


        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
                {{ form_label(form.primaryColor, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.primaryColor, {'attr': {'style':'height:40px;','class': 'w-full px-4 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.primaryColor) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.primaryColor) }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.secondaryColor, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.secondaryColor, {'attr': {'style':'height:40px;','class': 'w-full px-4 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.secondaryColor) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.secondaryColor) }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.typo, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.typo, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.typo) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.typo) }}</p>
                {% endif %}
            </div>

        </div>


        <div class="flex items-center gap-4 mt-6">
            <button
                    type="submit"
                    class="btn-primary">
                Enregistrer
            </button>
            <a href="{{ path('app_admin') }}" class="btn-neutral">Annuler</a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
