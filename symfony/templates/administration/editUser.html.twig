{% extends 'base.html.twig' %}

{% block title %}Édition utilisateur{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 py-8">
        <h1 class="text-2xl font-bold text-[#142742] mb-6">Modifier l'utilisateur #{{ user.id }}</h1>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

        <div>
            {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.email) }}

        </div>
        <div>
            {{ form_label(form.isFreeAccount, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            <div class="flex items-center">
                {{ form_widget(form.isFreeAccount, {'attr': {'class': 'mr-2'}}) }}
                {{ form_errors(form.isFreeAccount) }}
            </div>
        </div>

        <div>
            {{ form_label(form.roles, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.roles, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.roles) }}
        </div>

        <div>
            {{ form_label(form.password, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.password, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.password) }}
        </div>

        <div>
            {{ form_label(form.isVerified, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            <div class="flex items-center">
                {{ form_widget(form.isVerified, {'attr': {'class': 'mr-2'}}) }}
                {{ form_errors(form.isVerified) }}
            </div>
        </div>

        <div>
            {{ form_label(form.firstname, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.firstname, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.firstname) }}
        </div>

        <div>
            {{ form_label(form.lastname, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.lastname, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.lastname) }}
        </div>

        <div>
            <hr>
            <h2 class="text-lg font-semibold text-[#142742] mt-6 mb-4">Dernier contrat valide</h2>

            {% set lastSubscription = user.getLastSubscription() %}
            {% if lastSubscription %}
                {% set invoice = user.getLastInvoiceValid() %}

                <div class="bg-gray-50 border rounded p-4 space-y-2 text-sm text-gray-700">
                    <p><span class="font-medium">Date de paiement :</span> {{ invoice.paidAt|date('d/m/Y') }}</p>
                    <p><span class="font-medium">Utilisateurs :</span> {{ lastSubscription.limitUsers }}</p>
                </div>
            {% else %}
                <p class="text-sm text-gray-500 italic">Aucun contrat valide ce mois-ci.</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.country, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.country, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.country) }}
        </div>

        <div>
            {{ form_label(form.limitUsers, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.limitUsers, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.limitUsers) }}
        </div>

        <div class="flex items-center gap-4 mt-6">
            <button
                    type="submit"
                    class="btn-primary">
                Enregistrer
            </button>

            <a
                    href="{{ path('app_admin') }}"
                    class="btn-neutral">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
