{% extends 'base.html.twig' %}

{% block title %}Édition utilisateur{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 py-8">
        <h1 class="text-2xl font-bold text-[#142742] mb-6">Modifier l'utilisateur</h1>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

        <div>
            <div class="flex items-center">
                {{ form_label(form.isVerified, null, {'label_attr': {'class': 'inline-flex items-center space-x-2'}}) }}
                {{ form_widget(form.isVerified, {'attr': {'class': 'form-checkbox h-5 w-5 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 ml-4'}}) }}
                {{ form_errors(form.isVerified) }}
            </div>
        </div>

        <div>
            <div class="flex items-center">
                {{ form_label(form.isDisable, null, {'label_attr': {'class': 'inline-flex items-center space-x-2'}}) }}
                {{ form_widget(form.isDisable, {'attr': {'class': 'form-checkbox h-5 w-5 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 ml-4'}}) }}
                {{ form_errors(form.isDisable) }}
            </div>
        </div>

        <div>
            {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.email) }}

        </div>

        <div>
            {{ form_label(form.roles, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.roles, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.roles) }}
        </div>

        <div>
            {{ form_label(form.password, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.password, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.password) }}
        </div>

        <div>
            {{ form_label(form.firstname, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.firstname, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.firstname) }}
        </div>

        <div>
            {{ form_label(form.lastname, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.lastname, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.lastname) }}
        </div>


        <div>
            {{ form_label(form.country, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.country, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.country) }}
        </div>

        <div class="flex items-center gap-4 mt-6">
            <button
                    type="submit"
                    class="btn-primary">
                Enregistrer
            </button>
            <a href="{{ path('app_admin_school', { id: school.id }) }}" class="btn-neutral">Annuler</a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
