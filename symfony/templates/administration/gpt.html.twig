{% extends 'base.html.twig' %}

{% block title %}Administration - Clé Chat GPT{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto py-8">

        <h1 class="text-3xl font-bold title-primary mb-8">Configuration GPT</h1>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

        <div>
            {{ form_label(form.chatGPT, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.chatGPT, {'attr': {'class': 'w-full px-4 py-2 border rounded shadow-sm'}}) }}
            {{ form_errors(form.chatGPT) }}

        </div>

        <div class="flex items-center gap-4 mt-6">
            <button
                    type="submit"
                    class="btn-primary">
                Enregistrer
            </button>
        </div>

        {{ form_end(form) }}

    </div>
{% endblock %}
