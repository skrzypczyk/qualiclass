{% extends 'base.html.twig' %}

{% block title %}Modules{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto px-6 py-10 bg-white shadow rounded">
        <h1 class="text-3xl font-bold title-primary mb-8">
            Demander à ChatGPT de créer un module
        </h1>

        {{ form_start(form, {
            attr: {
                'data-turbo': 'false',
                'class': 'space-y-6'
            }
        }) }}

        <div>
            {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
            {% if form_errors(form.title) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.title) }}</p>
            {% endif %}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
                {{ form_label(form.duration, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.duration, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.duration) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.duration) }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.nbSessions, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.nbSessions, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.nbSessions) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.nbSessions) }}</p>
                {% endif %}
            </div>

            <div>

                {{ form_label(form.level, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.level, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.level) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.level) }}</p>
                {% endif %}
            </div>
        </div>



        <div class="flex items-center gap-4 pt-6">
            <button type="submit" class="btn-primary">
                Envoyer la demande
            </button>
        </div>

        {{ form_end(form) }}


        {% if syllabus is not null %}
            <h2 class='text-2xl font-bold title-primary mb-8'>Description et Objectifs</h2>
            {{ syllabus.description_and_objectives|raw }}

            <h2 class='text-2xl font-bold title-primary my-8'>Plan du module</h2>
            {{ syllabus.sessions|raw }}

            <h2 class='text-2xl font-bold title-primary my-8'>Activités et ressources</h2>
            {{ syllabus.activities_and_resources|raw }}


            <form method="POST" action="{{ path('app_module_store') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('validate_module') }}">
                <input type="hidden"  name="module_data" value='{{ syllabusJson }}'>
                <div class="text-center my-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        Créer le module
                    </button>
                </div>
            </form>

        {% endif %}
    </div>
{% endblock %}
