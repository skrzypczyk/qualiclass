{% extends 'base.html.twig' %}

{% block title %}Modules{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto px-6 py-10 bg-white shadow rounded">
        <h1 class="text-3xl font-bold title-primary mb-8">
            {{ create ? 'Ajout d’un module' : 'Modification du module' }}
        </h1>

        {{ form_start(form, {
            attr: {
                'data-turbo': 'false',
                'class': 'space-y-6'
            }
        }) }}

        <div>
            {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
            {% if form_errors(form.title) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.title) }}</p>
            {% endif %}
        </div>


        {% if app.user.isAdmin() %}
            <div>
                {{ form_label(form.isShared, null, {'label_attr': {'class': ' text-sm font-medium text-gray-700 mb-1 pr-6'}}) }}
                {{ form_widget(form.isShared, {'attr': {'class': ' px-6 py-2 '}}) }}
                {% if form_errors(form.isShared) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.isShared) }}</p>
                {% endif %}
            </div>
        {% endif %}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>

                {{ form_label(form.duration, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.duration, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.duration) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.duration) }}</p>
                {% endif %}
            </div>
            <div>
                {{ form_label(form.credit, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1 mt-1'}}) }}
                {{ form_widget(form.credit, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.credit) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.credit) }}</p>
                {% endif %}
            </div>
        </div>



        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                {{ form_label(form.categories, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.categories, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.categories) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.categories) }}</p>
                {% endif %}
            </div>
            <div>
                {{ form_label(form.assessments, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.assessments, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.assessments) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.assessments) }}</p>
                {% endif %}
            </div>

        </div>

        {% if app.user.isAdmin() %}
        <div>
            {{ form_label(form.owner, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.owner, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
            {% if form_errors(form.owner) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.owner) }}</p>
            {% endif %}
        </div>
        {% endif %}


        {# Objectif #}
        <div>
            {{ form_label(form.goal, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            <div data-controller="quill">
                <div class="quill-editor" style="height: 300px;"></div>
                {{ form_widget(form.goal, { attr: { style: 'display:none;' } }) }}
            </div>
            {% if form_errors(form.goal) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.goal) }}</p>
            {% endif %}
        </div>

        {# Syllabus #}
        <div>
            {{ form_label(form.syllabus, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            <div data-controller="quill">
                <div class="quill-editor" style="height: 300px;"></div>
                {{ form_widget(form.syllabus, { attr: { style: 'display:none;' } }) }}
            </div>
            {% if form_errors(form.syllabus) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.syllabus) }}</p>
            {% endif %}
        </div>

        {# Commentaire #}
        <div>
            {{ form_label(form.comment, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            <div data-controller="quill">
                <div class="quill-editor" style="height: 300px;"></div>
                {{ form_widget(form.comment, { attr: { style: 'display:none;' } }) }}
            </div>
            {% if form_errors(form.comment) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.comment) }}</p>
            {% endif %}
        </div>



        <div class="flex flex-wrap justify-center w-full gap-2 pt-6">
            <button type="submit" class="mt-4 md:w-50  w-full btn-primary text-white px-4 py-2 rounded">
                {{ create ? 'Créer le module' : 'Mettre à jour' }}
            </button>
            <a href="{{ path('app_module') }}" class="mt-4 md:w-50  w-full btn-neutral text-white px-4 py-2 rounded">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
