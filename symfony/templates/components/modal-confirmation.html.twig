<div x-show="{{ x_show|default('showConfirm') }}"
     class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50"
     x-cloak>
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">{{ title|default('Confirmation') }}</h2>
        <p class="text-gray-600 mb-6">{{ message|default('Êtes-vous sûr de vouloir continuer ?')|raw }}</p>

        <div class="flex flex-wrap justify-center w-full md:gap-2 mb-8">
            <button type="button"
                    @click="{{ confirmAction|default("document.getElementById('profil-form').submit()") }}"
                    class="btn btn-primary md:w-50 w-full btn-lg">
                {{ confirmLabel|default('Confirmer') }}
            </button>
            <button type="button"
                    @click="{{ x_show|default('showConfirm') }} = false"
                    class="btn btn-neutral md:w-50 w-full btn-lg">
                {{ cancelLabel|default('Annuler') }}
            </button>
        </div>
    </div>
</div>
