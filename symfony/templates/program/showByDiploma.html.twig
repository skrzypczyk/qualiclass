{% extends 'base.html.twig' %}

{% block title %}Programme{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto px-6 py-10 bg-white shadow rounded">
        <h1 class="text-3xl font-bold title-primary mb-8">
            {{ program.title }}<small class="font-normal text-gray-600 ml-2">
                    - Bac +{{ program.year }}
                </small>
        </h1>


        <h3 class="text-xl font-semibold mt-6 mb-2">Durée : <span class="font-normal" >{{ duration }} h</span></h3>

        <h3 class="text-xl font-semibold mt-6 mb-2">Crédits : <span class="font-normal" >{{ credit }}</span></h3>


        <h3 class="text-xl font-semibold mt-6 mb-2">Prérequis</h3>
        <p class="text-gray-700 mb-4">{{ program.prerequisites|raw }}</p>
        <h3 class="text-xl font-semibold mt-6 mb-2">Objectifs</h3>
        <p class="text-gray-700 mb-4">{{ program.goals|raw }}</p>
        <h3 class="text-xl font-semibold mt-6 mb-2">Commentaires</h3>
        <p class="text-gray-700 mb-4">{{ program.notes|raw }}</p>

        <table class="w-full my-10">
            <thead>
            <tr>
                <th class="px-6 py-4 text-left">Partie</th>
                <th class="px-6 py-4 text-left">Compétence / module</th>
                <th class="px-6 py-4 text-end">Durée</th>
                <th class="px-6 py-4 text-end">Crédits</th>
            </tr>
            </thead>
            <tbody>
            {% set totalDuration = 0 %}
            {% set totalCredit = 0 %}
            {% for part,assignments in moduleByPart %}
                {% set duration = 0 %}
                {% set credit = 0 %}
                {% for assignment in assignments %}

                    {% set duration = duration + assignment.module.duration %}
                    {% set credit = credit + (assignment.module.credit ?? 0) %}
                    {% set totalDuration = totalDuration + assignment.module.duration %}
                    {% set totalCredit = totalCredit + (assignment.module.credit ?? 0) %}

                    <tr class="bg-gray-200">
                        {% if loop.first %}
                        <td class="px-6 py-3 font-medium" rowspan="{{ assignments|length }}">
                            {{ part }}
                        </td>
                        {% endif %}
                        <td class="px-6 py-3 font-medium">
                            <a href="#module-{{ assignment.module.id }}">{{ assignment.module.title }}</a>
                        </td>
                        <td class="px-6 py-3 text-end">{{ assignment.module.duration }} h </td>
                        <td class="px-6 py-3 text-end">{{ assignment.module.credit??0 }}</td>
                    </tr>
                {% endfor %}
                <tr>
                    <th class="px-6 py-3 text-end" colspan="2">Total</th>
                    <th class="px-6 py-3 text-end"> {{ duration }} h</th>
                    <th class="px-6 py-3 text-end"> {{ credit }} </th>
                </tr>
            {% endfor %}
            <tfoot>
                <tr>
                    <th class="px-6 py-3 text-end" colspan="2">Total</th>
                    <th class="px-6 py-3 text-end"> {{ totalDuration }} h</th>
                    <th class="px-6 py-3 text-end"> {{ totalCredit }} </th>
                </tr>
            </tfoot>

            </tbody>
        </table>
    </div>

    <div class="max-w-5xl mx-auto my-4 px-6 py-10 bg-white shadow rounded">

        <h1 class="text-3xl font-bold title-primary my-8">
            {{ diploma.title }}<small class="font-normal text-gray-600 ml-2">
                    - {{ diploma.RNCP }}
                </small>
        </h1>

        {{ diploma.content|raw }}



        <table class="w-full mt-6">
            <thead>
                <tr>
                    <th class="px-6 py-4 text-left">Compétence / module</th>
                    <th class="px-6 py-4 text-end">Durée</th>
                    <th class="px-6 py-4 text-end">Crédits</th>
                </tr>
            </thead>
            <tbody>
            {% set totalDuration = 0 %}
            {% set totalCredit = 0 %}
            {% for competence in diploma.competences %}
            {% set compId = competence.id %}

                {% if moduleByCompetence[compId] is defined %}
                <tr class="bg-gray-200">
                    <td class="px-6 py-3 font-medium">
                        <a href="#comp-{{ compId }}">
                            {{ competence.title }}
                        </a>
                    </td>
                    <td class="px-6 py-3 text-end">{{ moduleByCompetence[compId].duration  }} h </td>
                    <td class="px-6 py-3 text-end">{{ moduleByCompetence[compId].credit }}</td>
                </tr>
                    {% set totalDuration = totalDuration + moduleByCompetence[compId].duration %}
                    {% set totalCredit = totalCredit + moduleByCompetence[compId].credit %}
                </tr>
                    {% for module in moduleByCompetence[compId].modules %}
                        <tr>
                            <td class="px-6 py-3 pl-10">
                                <a href="#module-{{ module.id }}">
                                    {{ module.title }}
                                </a>
                            </td>
                            <td class="px-6 py-3 text-end">{{ module.duration }} h </td>
                            <td class="px-6 py-3 text-end">{{ module.credit??0 }}</td>
                        </tr>
                    {% endfor %}
                {% else %}
                <tr  class="bg-gray-200">
                    <td class="px-6 py-3 font-medium >
                        <a href="#comp-{{ compId }}">
                            {{ competence.title }}
                        </a>
                    </td>
                    <td class="px-6 py-3 text-end">0 h</td>
                    <td class="px-6 py-3 text-end">0</td>
                </tr>
                {% endif %}
            {% endfor %}

            </tbody>
            <tfoot>
                <tr>
                    <th class="px-6 py-3 text-end">Total</th>
                    <th class="px-6 py-3 text-end">{{ totalDuration }} h</th>
                    <th class="px-6 py-3 text-end">{{ totalCredit??0 }}</th>
                </tr>
            </tfoot>
        </table>


    </div>
    <div class="max-w-7xl mx-auto px-6 py-10">
        <div class="mb-5">
            <h2 class="text-center text-3xl font-bold title-primary my-8">Blocs de compétences</h2>
            {% for competence in diploma.competences %}
                {% set compId = competence.id %}
                <div class="card mb-4 scroll-mt-24" id="comp-{{ compId }}">
                    <div class="card-header bg-primary text-white fw-bold p-4 mb-4">
                        {{ competence.title }}
                    </div>
                    <div class="card-body">
                        <div class="card-text">{{ competence.content | raw }}</div>

                        {% if moduleByCompetence[compId] is defined %}
                            <table class="w-full table-auto text-left my-6">
                                <thead class="bg-gray-200">
                                    <tr>
                                        <th class="px-6 py-4 text-left">Module</th>
                                        <th class="px-6 py-4 text-end">Durée</th>
                                        <th class="px-6 py-4 text-end">Crédits</th>
                                    </tr>
                                </thead>
                                <tbody>
                            {% for module in moduleByCompetence[compId].modules %}
                                    <tr>
                                        <td class="px-6 py-3 font-medium">
                                            <a href="#module-{{ module.id }}">
                                                {{ module.title }}</td>
                                            </a>
                                        <td  class="px-6 py-3 text-end">{{ module.duration  }} h</td>
                                        <td  class="px-6 py-3 text-end">{{ module.credit ?? 0 }}</td>
                                    </tr>
                            {% endfor %}
                                </tbody>
                                <tfoot class="bg-gray-200">
                                    <tr>
                                        <th class="px-6 py-3 text-end">Total</th>
                                        <th class="px-6 py-3 text-end">{{ moduleByCompetence[compId].duration }} h</th>
                                        <th class="px-6 py-3 text-end">{{ moduleByCompetence[compId].credit ?? 0 }}</th>
                                    </tr>
                                </tfoot>
                            </table>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

    </div>

    <div class="max-w-5xl mx-auto px-6 py-10">
        <div class="mb-5">
            <h2 class="text-center text-3xl font-bold title-primary mb-8">Liste des modules</h2>
            {% for competence in diploma.competences %}
                {% set compId = competence.id %}
                {% if moduleByCompetence[compId] is defined %}
                    {% for module in moduleByCompetence[compId].modules %}
                        <div class="card mb-4 scroll-mt-24" id="module-{{ module.id }}">
                            <div class="card-header bg-primary text-white fw-bold p-4 mb-4">
                                {{ module.title }}
                            </div>
                            <div class="card-body">


                                <h3 class="text-lg font-semibold mt-6 mb-2">Compétence : <span class="font-normal" ><a href="#comp-{{ competence.id }}">{{ competence.title }}</a></span></h3>
                                <h3 class="text-lg font-semibold mt-6 mb-2">Durée : <span class="font-normal" >{{ module.duration }} h </span></h3>
                                <h3 class="text-lg font-semibold mt-6 mb-2">Crédits : <span class="font-normal" >{{ module.credit }}</span></h3>
                                <h3 class="text-lg font-semibold mt-6 mb-2">Catégories :
                                    {% for category in module.categories %}
                                        <span class="text-sm text-primary">
                                            {% if not loop.first %}, {% endif %}
                                            {{ category.name }}
                                        </span>

                                    {% endfor %}
                                </h3>

                                <h3 class="text-xl text-center font-semibold mt-6 mb-4">Syllabus</h3>
                                <div class="card-text">{{ module.syllabus | raw }}</div>
                                <h3 class="text-xl text-center font-semibold mt-6 mb-4">Objectifs</h3>
                                <div class="card-text">{{ module.goal | raw }}</div>
                                <h3 class="text-xl text-center font-semibold mt-6 mb-4">Notes</h3>
                                <div class="card-text">{{ module.comment | raw }}</div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            {% endfor %}
        </div>

    </div>


{% endblock %}
