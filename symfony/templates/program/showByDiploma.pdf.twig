<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        @page {
            margin: 100px 50px 80px 50px;
        }

        @font-face {
            font-family: '{{ user.school.typo }}';
            src: url('fonts/{{ user.school.typo }}.ttf') format('truetype');
        }

        body {
            font-family: '{{ user.school.typo }}';
            font-size: 14px;
            color: {{ user.school.secondaryColor ?? '#000' }};
        }
        a{
            text-decoration: none;
        }

        header {
            position: fixed;
            top: -80px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 14px;
        }

        footer {
            position: fixed;
            bottom: -60px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 14px;
        }

        .pagenum:before {
            content: counter(page);
        }

        h1, h2, h3 {
            font-weight: bold;
        }

        h1 { font-size: 24px; }
        h2 { font-size: 20px; }
        h3 { font-size: 18px; margin-top: 50px;margin-bottom: 0px;}
        p, li { font-size: 14px; }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

        .page-break {
            page-break-before: always;
        }
    </style>
</head>
<body>
{% set logo = user.school.img ? 'uploads/schools/'~user.school.img: 'images/logo-qualiclass.png' %}

<div style="page-break-after: always; padding: 50px; height: 820px; text-align: center;background-color: {{ user.getSchoolPrimaryColor ?? '#fff' }}">
    <img src="{{ logo }}" alt="Page de garde" style="width: 40%; height: auto; margin: auto">

    <h1 style="font-size: 40px">
        {{ diploma.title }} <br><br> {{ diploma.RNCP }}
    </h1>
    <hr>
    <h1 style="font-size: 40px">
        {{ program.title }}
    </h1>
    <h2 style="font-size: 20px">
        {{ program.year }} année
    </h2>

    <img src="images/logo-qualiclass.png" alt="Qualiclass" style="width: 14%;  position: absolute; bottom: 10px; left: 43%">

</div>

<header style="background-color: {{ user.getSchoolPrimaryColor ?? '#fff' }};padding: 5px;">
    Programme – {{ program.title }} - {{ program.year }} année<br>
    {{ diploma.title }} - {{ diploma.RNCP }}
</header>

<footer>
    <table >
        <tr>
            <td style="text-align: center; border: 0px"><img src="{{ logo }}" alt="Page de garde" style="height: 60px;"></td>
            <td style="text-align: center; border: 0px">Page <span class="pagenum"></span></td>
            <td style="text-align: center; border: 0px"><img src="images/logo-qualiclass.png" alt="Qualiclass" style="height: 60px;"></td>
        </tr>
    </table>

</footer>

<div style="padding: 10px 10px;">
    <h1>
        {{ program.title }}
        <small style="font-weight: normal; font-size: 14px;">– {{ program.year }} année</small>
    </h1>

    <p>
        <strong>Durée : </strong>{{ duration }} h <br>
        <strong>Crédits : </strong>{{ credit }}
    </p>

    <h3>Prérequis</h3>
    <p>{{ program.prerequisites|raw }}</p>

    <h3>Objectifs</h3>
    <p>{{ program.goals|raw }}</p>

    <h3>Commentaires</h3>
    <p>{{ program.notes|raw }}</p>

    <div class="page-break"></div>

    <h1>{{ diploma.title }} <small style="font-weight: normal; font-size: 14px;">– {{ diploma.RNCP }}</small></h1>
    {{ diploma.content|raw }}

    <div class="page-break"></div>

    <h1 style="text-align: center; margin-bottom: 20px">Résumé du programme</h1>
    <table>
        <thead>
        <tr>
            <th>Compétence / module</th>
            <th style="text-align: center;">Durée</th>
            <th style="text-align: center;">Crédits</th>
        </tr>
        </thead>
        <tbody>
        {% for competence in diploma.competences %}
            {% set compId = competence.id %}
            {% if moduleByCompetence[compId] is defined %}
                <tr style="background-color: #eee;">
                    <td><a href="#comp-{{ compId }}">{{ competence.title }}</a></td>
                    <td style="text-align: center;">{{ moduleByCompetence[compId].duration }} h </td>
                    <td style="text-align: center;">{{ moduleByCompetence[compId].credit }}</td>
                </tr>
                {% for module in moduleByCompetence[compId].modules %}
                    <tr>
                        <td style="padding-left: 20px;"><a href="#module-{{ module.id }}">• {{ module.title }}</a></td>
                        <td style="text-align: center;">{{ module.duration }} h</td>
                        <td style="text-align: center;">{{ module.credit }}</td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr style="background-color: #eee;">
                    <td><a href="#comp-{{ compId }}">{{ competence.title }}</a></td>
                    <td style="text-align: center;">0 h</td>
                    <td style="text-align: center;">0</td>
                </tr>
            {% endif %}
        {% endfor %}
        </tbody>
        <tfoot>
        <tr>
            <th style="text-align: right;">Total</th>
            <th style="text-align: center;">{{ duration }} h</th>
            <th style="text-align: center;">{{ credit }}</th>
        </tr>
        </tfoot>
    </table>

    {% for competence in diploma.competences %}
        <div class="page-break"></div>
        {% set compId = competence.id %}
        <h2 id="comp-{{ compId }}">{{ competence.title }}</h2>
        <div>{{ competence.content | raw }}</div>

        {% if moduleByCompetence[compId] is defined %}
            <table>
                <thead>
                <tr>
                    <th>Module</th>
                    <th style="text-align: center;">Durée</th>
                    <th style="text-align: center;">Crédits</th>
                </tr>
                </thead>
                <tbody>
                {% for module in moduleByCompetence[compId].modules %}
                    <tr>
                        <td><a href="#module-{{ module.id }}">{{ module.title }}</a></td>
                        <td style="text-align: center;">{{ module.duration }} h</td>
                        <td style="text-align: center;">{{ module.credit }}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                <tr>
                    <th style="text-align: right;">Total</th>
                    <th style="text-align: center;">{{ moduleByCompetence[compId].duration }} h </th>
                    <th style="text-align: center;">{{ moduleByCompetence[compId].credit }}</th>
                </tr>
                </tfoot>
            </table>
        {% endif %}
    {% endfor %}

    {% for competence in diploma.competences %}
        {% set compId = competence.id %}
        {% if moduleByCompetence[compId] is defined %}
            {% for module in moduleByCompetence[compId].modules %}
                <div class="page-break"></div>
                <h2 id="module-{{ module.id }}">{{ module.title }}</h2>

                <p>
                    <strong>Compétence : </strong><a href="#comp-{{ competence.id }}">{{ competence.title }}</a><br>
                    <strong>Durée : </strong>{{ module.duration }} h<br>
                    <strong>Crédits : </strong>{{ module.credit }}<br>
                    <strong>Catégories : </strong>{% for category in module.categories %}
                    {% if not loop.first %}, {% endif %}{{ category.name }}
                    {% endfor %}<br>
                </p>

                <h2 style="text-align: center;">Objectifs</h2>
                <div>{{ module.goal | raw }}</div>

                <h2 style="text-align: center;">Plan de cours</h2>
                <div>{{ module.syllabus | raw }}</div>


                <h2 style="text-align: center;">Notes</h2>
                <div>{{ module.comment | raw }}</div>
            {% endfor %}
        {% endif %}
    {% endfor %}
</div>

<div class="page-break"></div>
<div style=" padding: 50px; margin-top: 280px; text-align: center;}">
    <img src="{{ logo }}" alt="Page de garde" style="width: 40%; height: auto; margin: auto">
</div>

</body>
</html>
