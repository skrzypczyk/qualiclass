{% extends 'base.html.twig' %}

{% block title %}Programme{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto px-6 py-10 bg-white shadow rounded">
        <h1 class="text-3xl font-bold title-primary mb-8">
            {{ program.title }}
            <span class="text-sm font-normal text-gray-600 ml-4">— Bac +{{ program.year }}</span>
        </h1>

        <a href="{{ path('app_program') }}" class="px-4 py-2 btn-primary">Liste des programmes</a>
        <a href="{{ path('app_program_assign', {'id': program.id}) }}" class="px-4 py-2 btn-primary ml-4">Affecter les modules</a>
        <a href="{{ path('app_program_edit', {'id': program.id}) }}" class="px-4 py-2 btn-danger ml-4">Modifier le programme</a>

        <h3 class="text-xl font-semibold mt-8 mb-4">Titres RNCP associés</h3>

        <ul class="list-disc pl-6 mb-4 my-4">
            {% for diploma in program.diplomas %}
                <li>
                    {{ diploma.RNCP }} : {{ diploma.title }}
                </li>
            {% else %}
                <li>Aucun titre RNCP associé.</li>
            {% endfor %}
        </ul>

        <h3 class="text-xl font-semibold mt-6 mb-2">Prérequis</h3>
        <p class="text-gray-700 mb-4">{{ program.prerequisites|raw }}</p>

        <h3 class="text-xl font-semibold mt-6 mb-2">Objectifs</h3>
        <p class="text-gray-700 mb-4">{{ program.goals|raw }}</p>

        <h3 class="text-xl font-semibold mt-6 mb-2">Commentaires</h3>
        <p class="text-gray-700 mb-4">{{ program.notes|raw }}</p>

        {# Liste des modules par partie #}
        <h3 class="text-xl font-semibold mt-8 mb-4">Modules affectés</h3>

        {% set globalHours = 0 %}
        {% set globalCredits = 0 %}

        {% for part, group in program.groupedAssignments %}
            {% set partHours = 0 %}
            {% set partCredits = 0 %}

            <div class="mb-6 border border-gray-200 rounded p-4 bg-gray-50">
                <h4 class="font-semibold text-lg mb-2 text-primary">Partie {{ part }}</h4>

                <ul class="space-y-1 text-sm text-gray-800">
                    {% for assignment in group %}
                        {% set partHours = partHours + assignment.module.duration %}
                        {% set partCredits = partCredits + assignment.module.credit %}
                        <li class="flex justify-between items-center">
                        <span>
                            {{ assignment.module.title }}
                            {% if assignment.module.shared %}<span class="ml-2 text-purple-600 text-xs font-semibold">[Partagé]</span>{% endif %}
                            {% if assignment.module.archived %}<span class="ml-2 text-gray-600 text-xs font-semibold">[Archivé]</span>{% endif %}
                        </span>
                            <span class="text-xs text-gray-600">
                            {{ assignment.module.duration }}h – {{ assignment.module.credit }} crédits
                        </span>
                        </li>
                    {% endfor %}
                </ul>

                <div class="mt-2 text-sm text-gray-600">
                    Total partie {{ part }} : <strong>{{ partHours }}h – {{ partCredits }} crédits</strong>
                </div>
            </div>

            {% set globalHours = globalHours + partHours %}
            {% set globalCredits = globalCredits + partCredits %}
        {% else %}
            <p class="text-gray-500">Aucun module affecté à ce programme.</p>
        {% endfor %}

        <div class="mt-6 text-right text-primary font-semibold">
            Total global : {{ globalHours }}h – {{ globalCredits }} crédits
        </div>
    </div>
{% endblock %}

