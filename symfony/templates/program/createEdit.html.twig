{% extends 'base.html.twig' %}

{% block title %}Programme{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto px-6 py-10 bg-white shadow rounded">
        <h1 class="text-3xl font-bold title-primary mb-8">
            {{ create ? 'Ajout d’un programme' : 'Modification du programme' }}
        </h1>

        {{ form_start(form, {
            attr: {
                'data-turbo': 'false',
                'class': 'space-y-6'
            }
        }) }}



        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.title) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.title) }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.year, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.year, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.year) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.year) }}</p>
                {% endif %}
            </div>

        </div>

        <div>
            {{ form_label(form.diplomas, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.diplomas, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
            {% if form_errors(form.diplomas) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.diplomas) }}</p>
            {% endif %}
        </div>


        {% if app.user.isAdmin() %}
        <div>
            {{ form_label(form.owner, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.owner, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
            {% if form_errors(form.owner) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.owner) }}</p>
            {% endif %}
        </div>
        {% endif %}


        {# Objectif #}
        <div>
            {{ form_label(form.goals, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            <div data-controller="quill">
                <div class="quill-editor" style="height: 300px;"></div>
                {{ form_widget(form.goals, { attr: { style: 'display:none;' } }) }}
            </div>
            {% if form_errors(form.goals) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.goals) }}</p>
            {% endif %}
        </div>

        {# Syllabus #}
        <div>
            {{ form_label(form.prerequisites, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            <div data-controller="quill">
                <div class="quill-editor" style="height: 300px;"></div>
                {{ form_widget(form.prerequisites, { attr: { style: 'display:none;' } }) }}
            </div>
            {% if form_errors(form.prerequisites) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.prerequisites) }}</p>
            {% endif %}
        </div>

        {# Commentaire #}
        <div>
            {{ form_label(form.notes, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            <div data-controller="quill">
                <div class="quill-editor" style="height: 300px;"></div>
                {{ form_widget(form.notes, { attr: { style: 'display:none;' } }) }}
            </div>
            {% if form_errors(form.notes) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.notes) }}</p>
            {% endif %}
        </div>

        <div class="flex items-center gap-4 pt-6">
            <button type="submit" class="btn-primary">
                {{ create ? 'Créer le programme' : 'Mettre à jour' }}
            </button>
            <a href="{{ path('app_program') }}" class="btn-neutral">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
