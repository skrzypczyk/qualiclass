{% extends 'base.html.twig' %}

{% block title %}Programmes{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto px-6 py-10">
        <h1 class="text-3xl font-bold title-primary mb-8">Vos programmes</h1>

        <a href="{{ path('app_program_create') }}" class="btn-primary px-4 py-2 mb-6 inline-block">
            Ajouter un programme
        </a>

        <div x-data="{ showModal: false, showModal2: false, modalProgramId: null }" class="space-y-6">

            {% for program in programs %}
                <div class="bg-white border border-gray-200 rounded-lg shadow p-6">
                    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                        <div>
                            <h2 class="text-xl font-semibold text-primary">
                                <a href="{{ path('app_program_show', {'id': program.id}) }}" class="hover:underline">
                                    {{ program.title }}
                                </a>
                            </h2>

                            {% if app.user.isAdmin() %}
                                <p class="text-sm text-gray-600">
                                    Auteur :
                                    {{ program.owner.lastname ?? program.owner.firstname ?? program.owner.email }}
                                </p>
                            {% endif %}
                        </div>

                        {# Boutons d'action #}
                        <div class="flex flex-col md:flex-row md:gap-2 w-full md:w-auto mb-4">
                            <a href="{{ path('app_program_edit', {'id': program.id}) }}" class="btn-primary text-sm w-full md:w-auto">
                                Modifier
                            </a>

                            <a href="{{ path('app_program_assign', {'id': program.id}) }}" class="btn-primary text-sm w-full md:w-auto">
                                Modules
                            </a>

                            <button type="button" @click="modalProgramId = '{{ program.id }}'; showModal2 = true;" class="btn-neutral text-sm w-full md:w-auto">
                                Dupliquer
                            </button>

                            <button type="button" @click="modalProgramId = '{{ program.id }}'; showModal = true;" class="btn-danger text-sm w-full md:w-auto">
                                Supprimer
                            </button>
                        </div>
                    </div>

                    {# Résumé du programme #}
                    {% set totalHours = 0 %}
                    {% set totalCredits = 0 %}
                    {% for assignment in program.assignments %}
                        {% set totalHours = totalHours + (assignment.module.duration ?? 0) %}
                        {% set totalCredits = totalCredits + (assignment.module.credit ?? 0) %}
                    {% endfor %}

                    <div class="mt-4 text-sm text-gray-700">
                        <strong>Durée du programme : </strong> {{ totalHours }}h
                    </div>
                    <div class="mt-2 text-sm text-gray-700">
                        <strong>Crédits : </strong>{{ totalCredits }}
                    </div>

                    <div class="mt-2 text-sm text-gray-700">
                        <p class="text-sm text-gray-500 mt-4">
                            {{ program.goals | raw }}
                        </p>
                    </div>

                    {# Diplômes associés #}
                    {% if program.diplomas|length %}
                        <div class="mt-8 text-sm">
                            <strong class="text-gray-700">Diplômes associés :</strong>
                            <ul class="list-disc list-inside mt-2 space-y-2">
                                {% for diploma in program.diplomas %}
                                    <li class="flex flex-col md:flex-row md:justify-between items-start gap-2 md:gap-4 my-4">
                                        <div>
                                            {{ diploma.title }}
                                            <small class="text-gray-500">({{ diploma.RNCP }})</small>

                                            {# Calcul des totaux pour ce diplôme #}
                                            {% set diplomaHours = 0 %}
                                            {% set diplomaCredits = 0 %}
                                            {% for mca in program.moduleCompetenceAssignments %}
                                                {% if mca.competence and mca.competence.diploma.id == diploma.id %}
                                                    {% set diplomaHours = diplomaHours + (mca.module.duration ?? 0) %}
                                                    {% set diplomaCredits = diplomaCredits + (mca.module.credit ?? 0) %}
                                                {% endif %}
                                            {% endfor %}

                                            <div class="{{ (totalHours != diplomaHours or totalCredits != diplomaCredits) ? 'text-red-500' : 'text-gray-500' }} text-xs mt-1">
                                                Total : {{ diplomaHours }}h – {{ diplomaCredits }} crédits
                                            </div>
                                        </div>

                                        <a href="{{ path('app_diploma_assign', { diploma: diploma.id, program: program.id }) }}"
                                           class="text-sm text-blue-600 hover:underline whitespace-nowrap  md:self-center">
                                            Affecter les modules
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {# Formulaires cachés pour duplication et suppression #}
                    <form method="post" action="{{ path('app_program_delete', {'id': program.id}) }}" id="delete-form-{{ program.id }}" class="hidden">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_program_' ~ program.id) }}">
                    </form>

                    <form method="post" action="{{ path('app_program_duplicate', {'id': program.id}) }}" id="duplicate-form-{{ program.id }}" class="hidden">
                        <input type="hidden" name="_token" value="{{ csrf_token('duplicate_program_' ~ program.id) }}">
                    </form>
                </div>
            {% else %}
                <p class="text-gray-500">Aucun programme pour le moment.</p>
            {% endfor %}

            {# Modale de confirmation – suppression #}
            {% include 'components/modal-confirmation.html.twig' with {
                x_show: 'showModal',
                title: 'Supprimer un programme',
                message: 'Souhaitez-vous vraiment supprimer ce programme ?',
                cancelLabel: 'Annuler',
                confirmLabel: 'Supprimer',
                confirmAction: "document.getElementById('delete-form-' + modalProgramId).submit()"
            } %}

            {# Modale de confirmation – duplication #}
            {% include 'components/modal-confirmation.html.twig' with {
                x_show: 'showModal2',
                title: 'Dupliquer un programme',
                message: 'Souhaitez-vous vraiment dupliquer ce programme ?',
                cancelLabel: 'Annuler',
                confirmLabel: 'Dupliquer',
                confirmAction: "document.getElementById('duplicate-form-' + modalProgramId).submit()"
            } %}
        </div>
    </div>
{% endblock %}
