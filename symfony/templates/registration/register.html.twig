{% extends 'base.html.twig' %}
{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="flex justify-center items-center h-full bg-gray-100 py-12">
        <div class="w-full max-w-md bg-white shadow-md rounded-lg p-8">
            <h1 class="text-3xl font-bold title-primary mb-8 text-center">Créer un compte</h1>

            {{ form_start(registrationForm, {'attr': {'class': 'space-y-6','data-turbo': 'false'}}) }}

            {% for field in [
                registrationForm.school,
                registrationForm.firstName,
                registrationForm.lastName,
                registrationForm.email,
                registrationForm.plainPassword.first,
                registrationForm.plainPassword.second,
                registrationForm.country
            ] %}
                {% set hasError = field.vars.errors|length > 0 %}
                <div>
                    {{ form_label(field, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    {{ form_widget(field, {
                        'attr': {
                            'class': 'block w-full px-4 py-2 rounded-md shadow-sm focus:ring focus:ring-indigo-200 ' ~
                            (hasError ? 'border-red-500 border' : 'border border-gray-300')
                        }
                    }) }}
                    {% if field.vars.errors|length > 0 %}
                        <div class="text-red-600 text-sm mt-1">
                            {{ form_errors(field) }}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}

            <!-- Termes -->
            <div>
                <div class="flex items-center">
                    {{ form_widget(registrationForm.agreeTerms, {
                        'attr': {'class': 'mr-2'}
                    }) }}
                    <label class="text-sm text-gray-700" for="registration_form_agreeTerms">
                        J’accepte les <a href="{{ path('app_cgu') }}" class="link-primary underline" target="_blank">CGU / CGV</a>
                    </label>
                </div>
                {{ form_errors(registrationForm.agreeTerms, {'attr': {'class': 'text-red-600 text-sm mt-1'}}) }}
            </div>

            <div class="flex justify-center my-4">
                <div>
                    {{ form_label(registrationForm.recaptcha, null, {'label_attr': {'class': 'block text-center text-gray-700 font-medium mb-2'}}) }}
                    {{ form_widget(registrationForm.recaptcha) }}
                    {{ form_errors(registrationForm.recaptcha) }}
                </div>
            </div>


            <!-- Bouton -->
            <button type="submit"
                    class="w-full btn-primary">
                S'inscrire
            </button>
            <div class="text-sm text-center ">
                <div>
                    <a href="{{ path('app_login') }}" class="link-primary block">
                        Se connecter
                    </a>
                </div>
                <div>
                    <a href="{{ path('app_forgot_password_request') }}" class="link-primary block">
                        Mot de passe oublié ?
                    </a>
                </div>
                <div>
                    <a href="{{ path('app_resend_confirmation') }}" class="link-primary block">
                        Renvoyer le lien d’activation
                    </a>
                </div>
            </div>

            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
