{% extends 'base.html.twig' %}

{% block title %}Choisir votre abonnement{% endblock %}

{% block body %}
    <section class="bg-white min-h-screen py-20 px-6">
        <div class="max-w-2xl mx-auto bg-white shadow-lg rounded-lg p-8"
             x-data="subscriptionForm(window.stripeProducts)"
        >

            <h1 class="text-3xl font-bold text-[#142742] mb-4 text-center">Abonnement QualiClass</h1>
            <p class="text-gray-700 text-center mb-8">
                Choisissez les options adaptées à votre établissement pour démarrer avec QualiClass.
            </p>

            <form method="post" action="{{ path('app_subscription_store') }}" class="space-y-6" data-turbo="false">
                {% for key, product in products %}
                    <div class="border rounded p-4 bg-gray-50">
                        <h2 class="text-lg font-semibold text-gray-800 mb-1">{{ product.name }}</h2>
                        <div class="text-sm text-gray-600 mb-3 prose prose-sm" >{{ product.description | raw }}</div>

                        <p class="text-indigo-600 font-semibold mb-2">
                            {{ product.price_amount|number_format(2, ',', ' ') }} € / Mois
                        </p>

                        {% if key != 'base' %}
                            <label class="block text-sm font-medium text-gray-700 mb-1">Quantité :</label>
                            <input
                                    type="number"
                                    name="quantities[{{ key }}]"
                                    min="0"
                                    x-model.number="quantities['{{ key }}']"
                                    class="w-full px-4 py-2 border rounded shadow-sm focus:ring-indigo-200"
                            >
                        {% else %}
                            <p class="text-sm text-gray-500 italic">Inclus automatiquement dans l’abonnement.</p>
                        {% endif %}
                    </div>
                {% endfor %}

                <hr class="my-6">

                <div class="text-xl font-bold text-right text-[#142742]">
                    Total estimé : <span x-text="total() + ' €'"></span>
                </div>

                <button type="submit"
                        class="w-full mt-6 bg-indigo-600 text-white font-semibold py-2 px-4 rounded hover:bg-indigo-700 transition">
                    Valider l’abonnement
                </button>
            </form>
        </div>
    </section>

    <script>
        window.stripeProducts = {{ products|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};

        function subscriptionForm(products) {
            return {
                products,
                quantities: {
                    school: 0,
                    user: 0
                },
                total() {
                    let total = products.base?.price_amount || 0;
                    for (const key in this.quantities) {
                        if (products[key] && products[key].price_amount) {
                            total += (this.quantities[key] || 0) * products[key].price_amount;
                        }
                    }
                    return total.toFixed(2);
                }
            }
        }
    </script>
{% endblock %}
