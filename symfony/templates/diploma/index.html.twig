{% extends 'base.html.twig' %}

{% block title %}Diplômes{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto px-6 py-10">
        <h1 class="text-3xl font-bold title-primary mb-8">Vos diplômes</h1>

        <div class="flex flex-wrap xs:justify-center w-full md:gap-2 py-4">
        <a href="{{ path('app_diploma_create') }}" class="mt-4 md:w-50  w-full btn-primary text-white px-4 py-2 rounded">Ajouter un diplôme</a>
        <a href="{{ path('app_diploma_import') }}" class="mt-4 md:w-50  w-full btn-primary text-white px-4 py-2 rounded">Importer un diplôme</a>
        </div>

        <div x-data="{ showModal: false, showModal2: false, modalModuleId: null }">
            <div class="bg-white shadow-md rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm text-left">
                        <thead>
                        <tr>
                            <th class="px-6 py-3 text-left">
                                Titre
                            </th>
                            <th class="px-6 py-3 text-left">
                                RNCP
                            </th>
                            <th class="px-6 py-3 text-left">Actions</th>
                        </tr>
                        </thead>
                        <tbody class="text-gray-800 text-sm divide-y divide-gray-100">
                        {% for diploma in diplomas %}
                            <tr class="transition">
                                <td class="px-6 py-4 font-medium">{{ diploma.title }}</td>
                                <td class="px-6 py-4 font-medium">{{ diploma.RNCP }}</td>

                                <td class="px-6 py-4 space-x-2">

                                    <a href="{{ path('app_diploma_edit', {'id': diploma.id}) }}"
                                       class="link-primary">
                                        Modifier
                                    </a>

                                    <button
                                            type="button"
                                            @click="modalDiplomaId = '{{ diploma.id }}'; showModal2 = true;"
                                            class="link-primary"
                                    >
                                        Dupliquer
                                    </button>

                                    <form method="post"
                                          action="{{ path('app_diploma_duplicate', {'id': diploma.id}) }}"
                                          id="duplicate-form-{{ diploma.id }}"
                                          class="hidden">
                                        <input type="hidden" name="_token" value="{{ csrf_token('duplicate_diploma_' ~ diploma.id) }}">
                                    </form>


                                    <button
                                            type="button"
                                            @click="modalDiplomaId = '{{ diploma.id }}'; showModal = true;"
                                            class="link-danger"
                                    >
                                        Supprimer
                                    </button>

                                    <form method="post"
                                          action="{{ path('app_diploma_delete', {'id': diploma.id}) }}"
                                          id="delete-form-{{ diploma.id }}"
                                          class="hidden">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_diploma_' ~ diploma.id) }}">
                                    </form>

                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>



            {% include 'components/modal-confirmation.html.twig' with {
                x_show: 'showModal',
                title: 'Supprimer un diplôme',
                message: 'Souhaitez-vous vraiment supprimer ce diplôme ?',
                cancelLabel: 'Annuler',
                confirmLabel: 'Supprimer',
                confirmAction: "document.getElementById('delete-form-' + modalDiplomaId).submit()"
            } %}

            {% include 'components/modal-confirmation.html.twig' with {
                x_show: 'showModal2',
                title: 'Dupliquer un diplôme',
                message: 'Souhaitez-vous vraiment dupliquer ce diplôme ?',
                cancelLabel: 'Annuler',
                confirmLabel: 'Dupliquer',
                confirmAction: "document.getElementById('duplicate-form-' + modalDiplomaId).submit()"
            } %}
        </div>


    </div>
{% endblock %}
