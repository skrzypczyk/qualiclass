{% extends 'base.html.twig' %}

{% block title %}Modules{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto px-6 py-10 bg-white shadow rounded">
        <h1 class="text-3xl font-bold title-primary mb-8">
            {{ create ? 'Ajout d’un diplôme' : 'Modification du diplôme' }}
        </h1>

        {{ form_start(form, {
            attr: {
                'data-turbo': 'false',
                'class': 'space-y-6'
            }
        }) }}


        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
                {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.title) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.title) }}</p>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.RNCP, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.RNCP, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm'}}) }}
                {% if form_errors(form.RNCP) %}
                    <p class="mt-1 text-sm text-red-600">{{ form_errors(form.RNCP) }}</p>
                {% endif %}
            </div>
        </div>



        <div>
            {{ form_label(form.content, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.content, {'attr': {'class': 'trix-content bg-white border border-gray-300 rounded-md p-2 h-[300px]'}}) }}
            {% if form_errors(form.content) %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.content) }}</p>
            {% endif %}
        </div>

        <div id="competences-wrapper"
             x-data="{ tabs: [], active: null, index: 0 }"
             x-ref="wrapper"
             x-init="tabs = Array.from({ length: {{ form.competences|length }} }, (_, i) => ({ id: i, label: '' })); active = tabs[0]?.id || null; index = {{ form.competences|length }};"
             data-prototype="{{ include('competence/_form_item.html.twig', { form: form.competences.vars.prototype, index: '__name__' })|e('html_attr') }}"
             class="pt-4">

            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold">Compétences</h2>
                <button type="button"
                        @click="
                            let html = $refs.wrapper.dataset.prototype.replace(/__name__/g, index);
                            tabs.push({ id: index, label: '' });
                            active = index;
                            let container = document.createElement('div');
                            container.innerHTML = html;
                            container.setAttribute('data-tab', index);
                            $refs.formContainer.appendChild(container);
                            index++;
                        "
                        class="btn-primary">
                    Ajouter une compétence
                </button>
            </div>

            <div class="flex overflow-x-auto no-scrollbar border-b mb-4 space-x-4 max-w-full">
                <template x-for="tab in tabs" :key="tab.id">
                    <button type="button"
                            @click="active = tab.id"
                            class="px-4 py-2 border-b-2"
                            :class="active === tab.id ? 'text-primary font-semibold border-blue-600' : 'border-transparent text-gray-500'">
                        Compétence <span x-text="tabs.indexOf(tab) + 1"></span>
                    </button>
                </template>
            </div>

            <div x-ref="formContainer">
                {% for competence in form.competences %}
                    {{ include('competence/_form_item.html.twig', {
                        form: competence,
                        index: loop.index0
                    }) }}
                {% endfor %}
            </div>
        </div>

        <div class="flex items-center gap-4 pt-6">
            <button type="submit" class="btn-primary">
                {{ create ? 'Créer le diplôme' : 'Mettre à jour' }}
            </button>
            <a href="{{ path('app_diploma') }}" class="btn-neutral">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
