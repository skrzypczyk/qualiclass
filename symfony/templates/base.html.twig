<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}QualiClass{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="https://web.cmp.usercentrics.eu/modules/autoblocker.js"></script>
    <script id="usercentrics-cmp" src="https://web.cmp.usercentrics.eu/ui/loader.js" data-settings-id="F5dxCZcJ0qx12h" async></script>


    {{ encore_entry_link_tags('app') }}
    {{ encore_entry_script_tags('app') }} {# Chargé ici pour Turbo #}
    <script src="https://unpkg.com/alpinejs" defer></script>
    <link rel="stylesheet" href="https://unpkg.com/trix@2.0.0/dist/trix.css">
    <script src="https://unpkg.com/trix@2.0.0/dist/trix.umd.min.js"></script>


    <script>
        function injectGAIfConsented() {
            if (window?.UC_UI?.getServicesBaseInfo) {
                const services = UC_UI.getServicesBaseInfo();
                const hasConsent = services.some(service =>
                    service.templateId === 'BJ59EidsWQ' && service.consent.status
                );

                console.log('[Turbo] Services Usercentrics :', services);

                if (hasConsent) {
                    console.log('✅ GA autorisé via consentement');

                    if (!window.gtagAlreadyInjected) {
                        const script = document.createElement('script');
                        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-XXR4PZVBJ8';
                        script.async = true;
                        document.head.appendChild(script);

                        window.dataLayer = window.dataLayer || [];
                        function gtag(){dataLayer.push(arguments);}
                        window.gtag = gtag;
                        gtag('js', new Date());
                        gtag('config', 'G-XXR4PZVBJ8');

                        window.gtagAlreadyInjected = true;
                    }
                } else {
                    console.warn('❌ GA bloqué : consentement non accordé');
                }
            }
        }

        window.addEventListener('UC_UI_INITIALIZED', injectGAIfConsented);
        document.addEventListener('turbo:load', injectGAIfConsented);
    </script>



</head>
<body class="min-h-screen flex flex-col bg-gray-100 text-gray-900">

{% include 'components/header.html.twig' %}


<main class="flex-grow">
    {% block body %}{% endblock %}
</main>

{% include 'components/footer.html.twig' %}
{% include 'components/flash-message.html.twig' %}


</body>
</html>
