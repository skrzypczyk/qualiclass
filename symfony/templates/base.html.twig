<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}QualiClass{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="https://web.cmp.usercentrics.eu/modules/autoblocker.js"></script>
    <script id="usercentrics-cmp" src="https://web.cmp.usercentrics.eu/ui/loader.js" data-settings-id="F5dxCZcJ0qx12h" async></script>


    {{ encore_entry_link_tags('app') }}
    {{ encore_entry_script_tags('app') }} {# Chargé ici pour Turbo #}
    <script src="https://unpkg.com/alpinejs" defer></script>
    <link rel="stylesheet" href="https://unpkg.com/trix@2.0.0/dist/trix.css">
    <script src="https://unpkg.com/trix@2.0.0/dist/trix.umd.min.js"></script>

    <script>
        window.addEventListener('UC_UI_INITIALIZED', function () {
            console.log('✅ CMP Usercentrics initialisé');
            if (typeof UC_UI !== 'undefined') {
                console.log('UC_UI.getServicesBaseInfo() =', UC_UI.getServicesBaseInfo?.());
            } else {
                console.warn('⛔ UC_UI est undefined');
            }
        });
    </script>


    <script>
        window.addEventListener("UC_UI_INITIALIZED", function () {
            if (window?.UC_UI?.getServicesBaseInfo) {
                const consentedServices = window.UC_UI.getServicesBaseInfo();
                const hasAnalyticsConsent = consentedServices.some(service =>
                    service.templateId === 'HkocEodjb7' && service.consent.status
                );

                if (hasAnalyticsConsent) {
                    // Inject GA uniquement si l'utilisateur a consenti
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', 'G-XXR4PZVBJ8');

                    const gtagScript = document.createElement('script');
                    gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-XXR4PZVBJ8';
                    gtagScript.async = true;
                    document.head.appendChild(gtagScript);
                }
            }
        });
    </script>



</head>
<body class="min-h-screen flex flex-col bg-gray-100 text-gray-900">

{% include 'components/header.html.twig' %}


<main class="flex-grow">
    {% block body %}{% endblock %}
</main>

{% include 'components/footer.html.twig' %}
{% include 'components/flash-message.html.twig' %}


</body>
</html>
