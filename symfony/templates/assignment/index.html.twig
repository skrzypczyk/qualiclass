{% extends 'base.html.twig' %}

{% block title %}Gérer les affectations{% endblock %}

{% block body %}

    <div class="max-w-7xl mx-auto px-6 py-10">
        <h1 class="text-3xl font-bold title-primary mb-8">Gérer les affectations</h1>

        <form method="post" action="{{ path('app_assignment_update') }}">
            <table class="min-w-full bg-white border border-gray-200 shadow-sm rounded-lg overflow-hidden" x-data="checkboxTable()">
                <thead class="">
                <tr>
                    <th class="px-4 py-2 text-left">Nom de l'utilisateur</th>
                    {% for school in schools %}
                        <th class="px-4 py-2 text-center">
                            {{ school.name }}
                            <div class="mt-1">
                                <button type="button" @click="toggleColumn({{ loop.index0 }}, true)" class="text-xs text-green-600 hover:underline">Tout cocher</button>
                                |
                                <button type="button" @click="toggleColumn({{ loop.index0 }}, false)" class="text-xs text-red-600 hover:underline">Tout décocher</button>
                            </div>
                        </th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody class="text-gray-800 text-sm divide-y divide-gray-200">
                {% for user in users %}
                    <tr>
                        <td class="px-4 py-2 font-semibold">{{ user.firstname }} {{ user.lastname }}<br><span class="text-xs text-gray-500">{{ user.email }}</span></td>

                        {% for school in schools %}
                            <td class="text-center">
                                <input type="checkbox"
                                       name="assignments[{{ user.id }}][]"
                                       value="{{ school.id }}"
                                       x-ref="checkbox"
                                       class="h-4 w-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500"
                                        {% if school in user.school %}
                                            checked
                                        {% endif %}
                                >
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <div class="mt-6 text-right">
                <button type="submit" class="btn-primary">
                    Enregistrer les affectations
                </button>
            </div>
        </form>

        <script>
            function checkboxTable() {
                return {
                    toggleColumn(index, checked) {
                        const rows = document.querySelectorAll('tbody tr');
                        rows.forEach(row => {
                            const checkbox = row.querySelectorAll('input[type=checkbox]')[index];
                            if (checkbox) {
                                checkbox.checked = checked;
                            }
                        });
                    }
                }
            }
        </script>

    </div>
{% endblock %}
