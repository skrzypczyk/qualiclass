{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto px-6 py-10">
        <h1 class="text-3xl font-bold title-primary mb-8">Tableau de bord</h1>


        {# ✅ 4 compteurs globaux #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">



            <div class="bg-white shadow rounded-lg text-center">
                {% if user.getSchool().getImg() is not null and user.getSchool().getImg() is not empty  %}
                    <img src="{{ asset('uploads/schools/'~user.getSchool().getImg()) }}" class="w-32 h-32 mx-auto" alt="School Image">
                {% else %}
                    <img src="{{ asset('images/logo-qualiclass.png') }}" class="w-32 h-32 mx-auto" alt="Default School Image">
                {% endif %}
            </div>


            <div class="bg-white shadow rounded-lg p-6 text-center">
                <div class="text-4xl font-bold text-[#1a355c]">{{ user.programs|length }}</div>
                <div class="mt-2 text-gray-600">Programmes</div>
            </div>
            <div class="bg-white shadow rounded-lg p-6 text-center">
                <div class="text-4xl font-bold text-[#1a355c]">{{ user.school.getDiplomas()|length }}</div>
                <div class="mt-2 text-gray-600">Diplômes</div>
            </div>
            <div class="bg-white shadow rounded-lg p-6 text-center">
                <div class="text-4xl font-bold text-[#1a355c]">{{ user.modules|length }}</div>
                <div class="mt-2 text-gray-600">Modules</div>
            </div>
        </div>


        <div class="bg-white shadow rounded-lg overflow-hidden">
            <table class="w-full table-auto text-left">
                <thead>
                <tr>
                    <th class="px-6 py-4">Programme <br> Diplôme - RNCP</th>
                    <th class="px-6 py-4 text-center">Nombre de modules</th>
                    <th class="px-6 py-4 text-center">Durée totale</th>
                    <th class="px-6 py-4 text-center">Total crédits</th>
                    <th class="px-6 py-4 text-center">Actions</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                {% for program in data %}
                    <tr class="bg-neutral ">
                        <td class="px-6 py-3 font-medium" colspan="5">
                            <a href="{{ path('app_program_show', {'id': program.id}) }}" class="text-primary hover:underline">{{ program.title }}</a>
                        </td>
                    </tr>

                {% for diploma in program.diplomas %}
                    <tr>
                        <td class="px-6 py-3 font-medium">
                            {{ diploma.title }}
                            <br>
                            {{ diploma.RNCP }}</td>
                        <td class="px-6 py-3 text-center">{{ diploma.counter }}</td>
                        <td class="px-6 py-3 text-center">
                            {{ diploma.duration }} h
                        </td>
                        <td class="px-6 py-3 text-center">{{ diploma.credit }}</td>
                        <td class="px-6 py-3 text-center space-x-2">
                            <a href="{{ path('app_program_diploma_show', {'program': program.id,'diploma': diploma.id}) }}" class="link-primary">Voir</a>
                            <a href="{{ path('app_program_diploma_show', {'program': program.id,'diploma': diploma.id,'format':'pdf'}) }}" class="link-primary ">PDF</a>
                        </td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center px-6 py-4 text-gray-500">Aucune donnée disponible</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

        </div>
    </div>
{% endblock %}
