{% extends 'base.html.twig' %}

{% block title %}Evaluations{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 py-8">

        {%  if create %}
            <h1 class="text-3xl font-bold title-primary mb-8">Ajouter une évaluation</h1>
        {% else %}
            <h1 class="text-3xl font-bold title-primary mb-8">Modifier cette évaluation</h1>
        {% endif %}

        {{ form_start(form, {'attr': { 'class': 'space-y-6'}}) }}

        <div>
            {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.name, {
                'attr': {
                    'class': 'block w-full px-4 py-2 rounded-md shadow-sm focus:ring focus:ring-indigo-200 border border-gray-300'
                }
            }) }}

            {% if form.name.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.name) }}</p>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'trix-content bg-white border border-gray-300 rounded-md p-2 h-[200px]'}}) }}

            {% if form.description.vars.errors|length > 0 %}
                <p class="mt-1 text-sm text-red-600">{{ form_errors(form.description) }}</p>
            {% endif %}
        </div>


        {%  if create %}
            <button type="submit" class="btn-primary">
                Ajouter
            </button>
        {% else %}
            <button type="submit" class="btn-primary">
                Modifier
            </button>
            <a href="{{ path('app_assessment') }}" class="btn-neutral">
                Annuler
            </a>
        {% endif %}

        {{ form_end(form) }}


        <h1 class="text-2xl font-bold title-primary mb-8">Liste des évaluations</h1>
        <div x-data="{ showModal: false, modalAssessmentId: null }">
            <table class="min-w-full bg-white border border-gray-200 shadow-md rounded-lg overflow-hidden">
                <thead class="">
                <tr>
                    <th class="px-6 py-3 text-left">Nom</th>
                    <th class="px-6 py-3 text-left">Description</th>
                    <th class="px-6 py-3 text-left">Actions</th>
                </tr>
                </thead>
                <tbody class="text-gray-800 text-sm divide-y divide-gray-100">
                {% for assessment in assessments|sort((a, b) => a.name <=> b.name) %}
                    <tr class="transition">
                        <td class="px-6 py-4 font-medium">{{ assessment.name }}</td>
                        <td class="px-6 py-4 font-medium">{{ assessment.description|raw }}</td>
                        <td class="px-6 py-4 space-x-4">

                            <a href="{{ path('app_edit_assessment', {'id': assessment.id}) }}"
                               class="inline-block text-sm text-blue-600 font-semibold hover:underline">
                                Modifier
                            </a>

                            <button
                                    type="button"
                                    @click="modalAssessmentId = '{{ assessment.id }}'; showModal = true;"
                                    class="inline-block text-sm text-red-600 font-semibold hover:underline"
                            >
                                Supprimer
                            </button>

                            <form method="post"
                                  action="{{ path('assessment_delete', {'id': assessment.id}) }}"
                                  id="delete-form-{{ assessment.id }}"
                                  class="hidden">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_assessment_' ~ assessment.id) }}">
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>


            {% include 'components/modal-confirmation.html.twig' with {
                x_show: 'showModal',
                title: 'Supprimer une évaluation',
                message: 'Souhaitez-vous vraiment supprimer cette évaluation ?',
                cancelLabel: 'Annuler',
                confirmLabel: 'Supprimer',
                confirmAction: "document.getElementById('delete-form-' + modalAssessmentId).submit()"
            } %}
        </div>


    </div>



{% endblock %}
