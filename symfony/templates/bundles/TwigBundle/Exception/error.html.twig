{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }} | QualiClass{% endblock %}

{% block body %}
    <div class="min-h-screen flex flex-col items-center justify-center text-center bg-gray-100 p-8">
        <img src="{{ asset('images/logo-qualiclass-small.png') }}" alt="QualiClass" class="w-40 mb-8">

        <h1 class="text-4xl font-bold text-primary">Code erreur : {{ status_code }}</h1>
        <p class="text-xl text-gray-700 mt-4">{{ status_text }}</p>
        <p class="text-lg text-gray-600 mt-2">
            Une erreur s'est produite. Veuillez réessayer plus tard ou contacter le support si le problème persiste.
        </p>

        <a href="{{ path('app_home') }}"
           class="mt-6 inline-block px-6 py-3 bg-primary text-white font-semibold rounded transition">
            Retour à l’accueil
        </a>
    </div>
{% endblock %}
